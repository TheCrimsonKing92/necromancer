{
  "name": "necromancer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A lean, narrative-first turn-based RPG for the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "perf:trace": "npm run build && node scripts/trace-performance.mjs",
    "perf:compare:local": "node scripts/compare-local-mutation-reports.mjs",
    "perf:trace:gpu": "npm run build && node scripts/trace-performance.mjs --gpu --gpu-phases",
    "perf:trace:gpu:chrome": "npm run build && node scripts/trace-performance.mjs --gpu --gpu-phases --browser-channel=chrome",
    "perf:trace:gpu:wpr": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/capture-wpr-gpu.ps1",
    "perf:trace:gpu:wpr:admin": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/capture-wpr-gpu.ps1 -Elevate",
    "perf:trace:gpu:wpr:probe": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/capture-wpr-gpu.ps1 -Workload probe",
    "perf:trace:gpu:wpr:probe:admin": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/capture-wpr-gpu.ps1 -Workload probe -Elevate",
    "perf:trace:gpu:chrome:experiments": "npm run build && node scripts/trace-performance.mjs --gpu --gpu-phases --gpu-experiments --browser-channel=chrome",
    "perf:trace:gpu:repeat": "npm run build && node scripts/run-performance-suite.mjs --runs=5",
    "perf:trace:local:repeat": "npm run build && node scripts/run-performance-suite.mjs --runs=5 --local-mutations",
    "perf:stats-construction": "npm run build && node scripts/run-stats-construction-experiment.mjs",
    "perf:trace:deep": "npm run build && node scripts/trace-performance.mjs --tail-observability --coverage --scale-persistence --surface-soak --worst-case",
    "perf:trace:deep:repeat": "npm run build && node scripts/run-performance-suite.mjs --runs=30 --local-mutations --tail-observability --coverage --scale-persistence --surface-soak --worst-case",
    "perf:trace:nightly": "npm run build && node scripts/run-performance-suite.mjs --runs=100 --local-mutations --tail-observability --coverage --scale-persistence --surface-soak --worst-case",
    "perf:trace:throttled": "npm run build && node scripts/trace-performance.mjs --cpu-throttle=4 --tail-observability --coverage --scale-persistence --surface-soak --worst-case",
    "perf:trace:gpu:chrome:repeat": "npm run build && node scripts/run-performance-suite.mjs --runs=5 --browser-channel=chrome",
    "perf:trace:gpu:chrome:stats:repeat": "npm run build && node scripts/run-performance-suite.mjs --runs=5 --gpu-experiments --gpu-experiment-filter=stats --browser-channel=chrome",
    "perf:trace:120:probe": "npm run build && node scripts/trace-high-refresh.mjs",
    "perf:trace:120": "npm run build && node scripts/trace-high-refresh.mjs --require-high-refresh",
    "perf:trace:120:repeat": "npm run build && node scripts/run-high-refresh-suite.mjs --runs=5",
    "perf:trace:120:delivery": "npm run build && node scripts/run-high-refresh-suite.mjs --runs=5 --require-delivery",
    "perf:trace:120:diagnostic": "npm run build && node scripts/trace-high-refresh.mjs --frame-trace",
    "perf:trace:gpu:deep": "npm run build && node scripts/run-performance-suite.mjs --runs=15",
    "perf:trace:gpu:experiments": "npm run build && node scripts/trace-performance.mjs --gpu --gpu-phases --gpu-experiments",
    "perf:trace:gpu:experiments:repeat": "npm run build && node scripts/run-performance-suite.mjs --runs=5 --gpu-experiments",
    "perf:trace:gpu:inventory:repeat": "npm run build && node scripts/run-performance-suite.mjs --runs=5 --gpu-experiments --gpu-experiment-filter=inventory",
    "assets:optimize:items": "node scripts/optimize-item-sprites.mjs",
    "assets:experiment:items": "node scripts/item-art-resource-experiment.mjs",
    "assets:publish:items": "node scripts/item-art-resource-experiment.mjs --publish",
    "assets:publish:scene": "node scripts/publish-generated-scene-art.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:prose": "node scripts/check-prose.mjs",
    "check:ui-contracts": "node scripts/check-ui-contracts.mjs",
    "voice:auditions:validate": "node tools/voice-auditions/validate-manifest.mjs",
    "test": "node scripts/check-architecture.mjs && node scripts/check-prose.mjs && node --test scripts/check-prose.test.mjs scripts/voice-audition-manifest.test.mjs scripts/development-tactical-layout.test.mjs scripts/visual-rig-browser.test.mjs scripts/performance-browser.test.mjs scripts/performance-gpu.test.mjs scripts/performance-gpu-experiments.test.mjs scripts/performance-high-refresh.test.mjs scripts/windows-gpu-diagnostics.test.mjs scripts/performance-layer-tree.test.mjs scripts/performance-phase-diagnostics.test.mjs scripts/performance-benchmark-summary.test.mjs scripts/performance-tail-observability.test.mjs scripts/performance-resource-coverage.test.mjs scripts/performance-resource-graph.test.mjs scripts/performance-memory-infra.test.mjs scripts/wpr-gpu-memory.test.mjs scripts/performance-scale-fixtures.test.mjs scripts/performance-scale-browser.test.mjs scripts/performance-worst-case-fixtures.test.mjs scripts/performance-deep-diagnostics.test.mjs scripts/item-art-resource-experiment.test.mjs && vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build && npm run check:ui-contracts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
